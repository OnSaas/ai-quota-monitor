# Actions / local collector (never send these to the Worker)
WORKER_PUSH_URL=https://ai-quota-monitor.<your-subdomain>.workers.dev/v1/push
PUSH_TOKEN=change-me-push-token

# Copilot — classic PAT or fine-grained token with user Plan:read
COPILOT_TOKEN=
# Optional: username override; otherwise GET /user
COPILOT_USERNAME=
# Optional: org billed Copilot (needs Administration:read on the org)
COPILOT_ORG=
# Used to turn used quantity into remaining % when GitHub does not return a cap
COPILOT_MONTHLY_ALLOWANCE=300

# Grok Build / xAI — API key (xai-...) or SuperGrok bearer. Expires: update the secret.
GROK_TOKEN=

# Claude official API usage (Admin API key or OAuth). Not the 5h/7d subscription window.
ANTHROPIC_ADMIN_KEY=

# Codex is not implemented (see docs/PROVIDERS.md)
# CODEX_TOKEN=
